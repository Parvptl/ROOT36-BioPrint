# BioPrint backend configuration.
# Copy to backend/.env and adjust. Never commit the real .env.

# Secret used to sign session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BIOPRINT_SECRET_KEY=change-me-generate-a-real-secret

# SQLite database path (relative to backend/ unless absolute).
BIOPRINT_DB_PATH=data/bioprint.db

# Seconds a login behavioural challenge stays valid before it expires.
BIOPRINT_CHALLENGE_TTL_SECONDS=120

# Session lifetime in seconds for an allowed login.
BIOPRINT_SESSION_TTL_SECONDS=1800

# Allowed CORS origins for the Vite dev server, comma separated.
BIOPRINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retain raw behavioural events after extraction. DEBUG ONLY, default off.
# Turning this on stores keystroke timing streams on disk; see docs/privacy.
BIOPRINT_RETAIN_RAW_EVENTS=false
