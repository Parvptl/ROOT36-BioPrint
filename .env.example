# BioPrint backend configuration.
# Copy to backend/.env and adjust. Never commit the real .env.

# Secret used to sign session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BIOPRINT_SECRET_KEY=change-me-generate-a-real-secret

# SQLite database path (relative to backend/ unless absolute).
BIOPRINT_DB_PATH=data/bioprint.db

# Seconds a login behavioural challenge stays valid before it expires.
BIOPRINT_CHALLENGE_TTL_SECONDS=120

# Session lifetime in seconds for an allowed login.
BIOPRINT_SESSION_TTL_SECONDS=1800

# Allowed CORS origins for the Vite dev server, comma separated.
BIOPRINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retain raw behavioural events after extraction. DEBUG ONLY, default off.
# Turning this on stores keystroke timing streams on disk; see docs/privacy.
BIOPRINT_RETAIN_RAW_EVENTS=false

# Operator key for the security console at /security.
#
# That console serves the exact per-attempt identity and automation scores,
# which the login response deliberately withholds so it cannot be used to tune
# an impersonation. Leave this EMPTY and the console returns 404 and does not
# exist. Set it only where an operator genuinely needs the numbers.
BIOPRINT_OPERATOR_KEY=

# Key for POST /demo/reset, which deletes all users, profiles, challenges and
# audit rows so a live demo can start clean. Empty disables the endpoint.
# It only deletes; it never writes scores or forces a decision.
BIOPRINT_DEMO_RESET_KEY=

# Comma-separated feature names to disable, for experiments. See
# backend/app/behavioral/features/registry.py for the list.
BIOPRINT_DISABLED_FEATURES=
