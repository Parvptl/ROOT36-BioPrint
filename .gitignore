# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Environment / secrets
.env
.env.*
!.env.example

# Local database + runtime artifacts
*.db
*.db-journal
*.sqlite3
backend/data/*
# Phase E real-human evaluation captures. Listed explicitly rather than left to
# the wildcard above: this directory holds behavioural feature vectors from
# consenting participants, and a rule that says so is worth more than one that
# happens to cover it.
backend/data/evaluation/
# ...except the population priors. They are ~5 KB of per-feature population
# statistics — no participant ids, no raw keystrokes, nothing that identifies
# anyone — and they are an input to authentication, not an output of it. A
# clone without them silently falls back to the RELATIVE_SPREAD constant,
# which is a different system from the one that was evaluated.
!backend/data/*.json

# Raw research corpora. The Aalto 136M Keystrokes download is ~168,000 files
# and several GB; it is obtained from the publisher, not from this repository.
# Listed explicitly rather than relying on nobody ever running `git add -A`.
backend/evaluation/ml/data/
# Trained experiment checkpoints, regenerated by the training scripts.
*.pth

# Evaluation output (regenerated, not committed as results).
#
# The preserved baseline is the exception: a run that has already been cited in
# the report is evidence, and regenerating it is not possible. Its JSON summary
# is kept; the database snapshot beside it is not, because it holds fitted
# behavioural profiles.
evaluation/out/*
!evaluation/out/baseline/
evaluation/out/baseline/*
!evaluation/out/baseline/*.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Trained per-user models (regenerated at enrollment)
backend/data/models/

# Local editor and tooling configuration
.claude/
