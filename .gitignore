# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Environment / secrets
.env
.env.*
!.env.example

# Local database + runtime artifacts
*.db
*.db-journal
*.sqlite3
backend/data/

# Evaluation output (regenerated, not committed as results).
#
# The preserved baseline is the exception: a run that has already been cited in
# the report is evidence, and regenerating it is not possible. Its JSON summary
# is kept; the database snapshot beside it is not, because it holds fitted
# behavioural profiles.
evaluation/out/*
!evaluation/out/baseline/
evaluation/out/baseline/*
!evaluation/out/baseline/*.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Trained per-user models (regenerated at enrollment)
backend/data/models/

# Local editor and tooling configuration
.claude/
